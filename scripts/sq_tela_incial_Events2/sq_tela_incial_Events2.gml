// Auto-generated stubs for each available event.

function sq_tela_incial_event_create()
{
	//Começar pausando!
	//Pegando a minha layer
	var _lay = layer_get_id("Inicio");
	//Pegando a sequence dentro da layer
	var _seq = layer_get_all_elements(_lay)[0]
	
	//Ele retorna um array com todos os elementos
	//No nosso caso a layer
	//Pausando a sequencia
	layer_sequence_pause(_seq)
}

